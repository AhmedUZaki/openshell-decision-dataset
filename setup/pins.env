# Every version and setting that defines this environment. Read by setup/wsl-linux/install-stack.sh
# (bash) and setup/Verify-Installation.ps1; recorded with each saved bundle (environment.json).
# Change a value here and nowhere else, then rerun Install Everything.cmd and Verify Installation.cmd.
# KEY=VALUE only, LF line endings, no quotes or spaces around "=".
MODEL=qwen2.5:1.5b
OLLAMA_VERSION=0.40.13
NEMOCLAW_VERSION=0.0.140
NEMOCLAW_BASE=88fe14f3fb9a0bf72997cce19ec88b5b2ee08391
NEMOCLAW_BACKPORT=4ec4ec634e5e9cf5f00c6bb2d2786a5b5b73eef9
OPENCLAW_VERSION=2026.9.2
OPENSHELL_VERSION=0.0.116
SANDBOX_NAME=my-assistant
DASHBOARD_PORT=18789
CONTEXT_WINDOW=32768
MAX_TOKENS=2048
POLICY_TIER=balanced
# Presets the Balanced tier lists but non-interactive onboarding leaves out (brave; tavily only when selected as the search provider).
# Applied with `nemoclaw <sandbox> policy add <preset> --yes` after onboarding, to my-assistant and to every conversation.
POLICY_EXTRA_PRESETS=brave
